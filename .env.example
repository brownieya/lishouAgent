# Copy to .env locally; real credentials must never be committed.
DB_NAME=lishou_agent
DB_USERNAME=
DB_PASSWORD=
DASHSCOPE_API_KEY=
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
DB_PUBLISHED_PORT=5433
WEB_PORT=8080
# Default loopback access; set the host's LAN IP when internal access is ready.
WEB_BIND_ADDRESS=127.0.0.1
